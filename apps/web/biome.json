{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"root": false,
	"extends": ["@repo/biome-config/base"],
	"files": {
		"includes": ["**", "!dist/**", "!.astro/**", "!.wrangler/**"]
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}

{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "whoami-web",
	"main": "./dist/_worker.js/index.js",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	}
}

{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"root": true,
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"linter": {
		"enabled": true
	},
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "off" } }
	},
	"formatter": {
		"lineWidth": 120,
		"indentStyle": "tab",
		"indentWidth": 2
	}
}

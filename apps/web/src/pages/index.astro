---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
import { formatPostDate, listPosts } from "../lib/blogs";

const posts = await listPosts();
const { home } = site;
---

<BaseLayout title={site.title} description={site.description} current="home">
	<main class="reading home">
		<h1 class="home-title">{home.headline}</h1>

		<div class="home-prose">
			{home.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			<ul>
				{
					home.links.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a> - {link.blurb}
						</li>
					))
				}
			</ul>
			<p class="home-note">{home.note}</p>
		</div>

		<section class="home-posts" aria-labelledby="home-posts-heading">
			<h2 id="home-posts-heading">{home.postsHeading}</h2>
			{
				posts.length === 0 ? (
					<p class="muted">{home.emptyPosts}</p>
				) : (
					<ul class="home-post-list">
						{posts.map((post) => (
							<li>
								<a href={`/blogs/${post.slug}`}>{post.title}</a>
								{post.publishedAt ? (
									<span class="muted"> · {formatPostDate(post.publishedAt)}</span>
								) : null}
							</li>
						))}
					</ul>
				)
			}
		</section>
	</main>
</BaseLayout>
